# Used when running the API/agents directly on the host (outside Docker).

ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

DATABASE_URL=postgresql+asyncpg://polymarket:polymarket@localhost:5432/polymarket
DATABASE_URL_SYNC=postgresql+psycopg2://polymarket:polymarket@localhost:5432/polymarket

REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

MARKET_SCAN_INTERVAL_SECONDS=60
MARKET_SCAN_PAGE_SIZE=100
MARKET_SCAN_MAX_MARKETS=500

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434

DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
