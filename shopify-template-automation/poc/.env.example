# --- Scenario A : vente du template comme produit digital dans MA boutique ---
# Aucune de ces valeurs n'est necessaire pour `npm run demo` (mock) ni `npm run dry-run`.

# Domaine myshopify de la boutique
SHOPIFY_SHOP=ma-boutique.myshopify.com

# Token Admin API. Obtention MANUELLE (voir README section "Bootstrap humain").
# Scopes requis : write_products, write_files, write_content, write_publications, write_themes
SHOPIFY_ADMIN_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Version d'API figee volontairement (ne jamais utiliser "latest" en production)
SHOPIFY_API_VERSION=2025-10

# GID de la publication "Online Store".
# Recuperable via la query `publications(first: 10) { nodes { id name } }`.
SHOPIFY_ONLINE_STORE_PUBLICATION_ID=gid://shopify/Publication/1234567890

# Mode mock : si defini, toutes les requetes partent vers ce endpoint local
# SHOPIFY_MOCK_ENDPOINT=http://127.0.0.1:8788/admin/api/2025-10/graphql.json
