 ELEVEN_MODEL_ID = "eleven_flash_v2_5"
 
+# --- macOS native voice (free, offline) -----------------------------------
+# `say` is part of macOS. It writes AIFF; afconvert turns that into the
+# 16-bit PCM WAV the browser's decodeAudioData accepts everywhere.
+MACOS_DEFAULT_VOICE = "Thomas"      # French (male). "Audrey" is the female one.
+
+
+async def synthesize_macos(text: str, voice: str = MACOS_DEFAULT_VOICE,
+                           rate: int = 185) -> Optional["SynthResult"]:
+    """Speak `text` with the macOS `say` command and return WAV bytes.
+
+    Costs nothing and needs no network. Returns None on any failure so the
+    caller degrades to text, exactly as it does for the paid providers.
+    """
+    text = (text or "").strip()
+    if not text:
+        return None
+    if not shutil.which("say") or not shutil.which("afconvert"):
+        log.error("macOS TTS asked for but `say`/`afconvert` are missing")
+        return None
+    t0 = time.monotonic()
+    with tempfile.TemporaryDirectory(prefix="jarvis-say-") as tmp:
+        aiff = f"{tmp}/out.aiff"
+        wav = f"{tmp}/out.wav"
+        try:
+            for argv in (["say", "-v", voice, "-r", str(rate), "-o", aiff, "--", text],
+                         ["afconvert", "-f", "WAVE", "-d", "LEI16", aiff, wav]):
+                proc = await asyncio.create_subprocess_exec(
+                    *argv, stdout=asyncio.subprocess.DEVNULL,
+                    stderr=asyncio.subprocess.PIPE)
+                _, err = await proc.communicate()
+                if proc.returncode != 0:
+                    log.error(f"macOS TTS failed ({argv[0]}): "
+                              f"{(err or b'').decode(errors='replace')[:200]}")
+                    return None
+            audio = open(wav, "rb").read()
+        except OSError as e:
+            log.error(f"macOS TTS error: {e}")
+            return None
+    if not audio:
+        return None
+    took = time.monotonic() - t0
+    return SynthResult(audio, took, took)
+
 
 @dataclass
 class SynthResult:
