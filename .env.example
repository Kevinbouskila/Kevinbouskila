# Used by docker-compose.yml — service hostnames (postgres, redis), not localhost.

ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production

DATABASE_URL=postgresql+asyncpg://polymarket:polymarket@postgres:5432/polymarket
DATABASE_URL_SYNC=postgresql+psycopg2://polymarket:polymarket@postgres:5432/polymarket

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

POLYMARKET_GAMMA_API_URL=https://gamma-api.polymarket.com
POLYMARKET_CLOB_API_URL=https://clob.polymarket.com

MARKET_SCAN_INTERVAL_SECONDS=60
MARKET_SCAN_PAGE_SIZE=100
MARKET_SCAN_MAX_MARKETS=500

# --- LLM providers (wired up in a later step) ---
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
OLLAMA_BASE_URL=http://ollama:11434

# --- Notifications (wired up in a later step) ---
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SLACK_WEBHOOK_URL=
